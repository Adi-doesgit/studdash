# =============================================
# Student Dashboard - Environment Variables
# =============================================
# Copy this file to .env and customize values
# NEVER commit the actual .env file to git
# =============================================

# Backend server port
PORT=5000

# JWT Secret (fallback — prefer Docker secrets in production)
JWT_SECRET=change-me-to-a-secure-random-string

# PostgreSQL connection
DB_HOST=postgres
DB_PORT=5432
DB_USER=studdash
DB_PASSWORD=change-me-to-a-secure-password
DB_NAME=studdash
